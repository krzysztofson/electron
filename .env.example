# Copy to .env.local and fill in. .env.local is gitignored.
#
# Packaged builds do NOT read this file -- they read a .env in the app's
# user-data directory instead (see src/main/config.ts), because a launch from
# Finder inherits no shell environment and app.asar is not a writable place to
# keep a key.

# --- Screen analysis (F5) --------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.6-terra (balanced cost/capability, vision-capable).
# Alternatives: gpt-6-astra (most capable), gpt-5.6-sol, gpt-5.6-luna (cheapest).
OPENAI_MODEL=

# Optional. Overrides the built-in analysis prompt.
ANALYSIS_PROMPT=

# Optional. Caps response length. Default 4096.
OPENAI_MAX_OUTPUT_TOKENS=

# Optional. Screenshot resolution sent to the model. Defaults to 1200x800.
# Raise if the model struggles to read small code.
CAPTURE_WIDTH=
CAPTURE_HEIGHT=

# --- Live transcription ----------------------------------------------------
# https://aistudio.google.com/apikey
# A plain API key: no service account, no JSON file.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-transcribe-live.
GEMINI_TRANSCRIBE_MODEL=

# --- Diagnostics -----------------------------------------------------------
# error | warn | info | debug. Defaults to info in dev, warn in production.
# Use debug to see per-audio-chunk activity.
LOG_LEVEL=
